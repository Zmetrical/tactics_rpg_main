extends RefCounted

const Ability = preload("res://scripts/battle/ability.gd")
const UnitData = preload("res://scripts/battle/unit_data.gd")
const Equipment = preload("res://scripts/inventory/equipment.gd")
const Tuning = preload("res://scripts/battle/combat_tuning.gd")
const Discipline = preload("res://scripts/skills/discipline.gd")

enum Side { PLAYER, ENEMY }
## Which kind of status an attacker is applying. Values match Ability.DamageType.
enum StatusCategory { PHYSICAL, MAGICAL }
enum StatusTier { NONE, DISRUPT, BREACH, OVERLOAD }

var data: UnitData
var unit_name: String
var side: int
var cell: Vector2i
var height: int = 0
## Tile direction (a unit step) this unit faces. ZERO = not set yet. Flanking reads it.
var facing: Vector2i = Vector2i.ZERO
var max_hp: int
var hp: int
## Spec names for Core Health. Aliases of max_hp / hp so the HUD and existing code keep working.
var max_core_health: int:
	get: return max_hp
	set(value): max_hp = value
var current_core_health: int:
	get: return hp
	set(value): hp = value
## Ablative defenses: soak damage before Core Health. Not regenerated by this system.
var physical_armor: int = 0  # physical defense, current
var magic_barrier: int = 0  # magical defense, current
## Ceilings = UnitData base + worn gear. Gear changes move the current value by the same amount.
var max_physical_armor: int = 0
var max_magic_barrier: int = 0
var _gear_physical_armor: int = 0
var _gear_magic_barrier: int = 0
## Fractions, see CombatTuning.RESISTANCE_MIN/MAX. Only Disrupt changes them (and, if
## APPLY_RESISTANCE_IN_TAKE_DAMAGE is on, they scale incoming damage). Gear does not touch them.
var physical_resistance: float = 0.0
var magic_resistance: float = 0.0
## Impact trackers: progress toward the next stack. Cleared when this unit starts its turn.
var physical_impact_pool: float = 0.0
var magic_impact_pool: float = 0.0
var armor_shred_stacks: int = 0
var fracture_stacks: int = 0
## Tier 2/3 effects currently on this unit: effect id (StringName) -> turns remaining.
var statuses: Dictionary = {}
var ac: int
var prof: int
var spd: int
var move_range: int
var jump: int
var mods: Array[int] = []
var abilities: Array[Ability] = []
## Paper-doll gear. Worn weapons put their attack at the front of `abilities`; changing gear
## rebuilds the list on its own.
var equipment := Equipment.new()
var _innate_abilities: Array[Ability] = []   # every skill / spell this unit has learned
var _memorized: Array[Ability] = []          # the learned subset in memory slots; only these are usable
## Ability -> own turns left before it is ready again. Missing key = ready.
var cooldowns: Dictionary = {}
## Memory slots. Each memorized skill / spell takes its `memory_cost` (1-3) of them. Weapon attacks do not count.
var skill_slots: int = Tuning.DEFAULT_SKILL_SLOTS
## Discipline id -> rank. Gates learning SkillDefs (see can_learn). Starts from UnitData.discipline_ranks.
var discipline_ranks: Dictionary = {}

var ct: int = 0
## Action Points: every attack / spell spends them, +AP_REGEN at the start of this unit's turn.
## Starts at 0, so a unit's first turn begins with AP_REGEN.
var ap: float = 0.0
var max_ap: float = Tuning.AP_MAX
var movement: int = 0

func _init(p_data: UnitData, p_side: int, p_cell: Vector2i) -> void:
	data = p_data
	unit_name = p_data.display_name
	side = p_side
	cell = p_cell
	max_hp = p_data.max_hp
	hp = p_data.max_hp
	ac = p_data.ac
	physical_armor = p_data.physical_armor
	magic_barrier = p_data.magic_barrier
	max_physical_armor = p_data.physical_armor
	max_magic_barrier = p_data.magic_barrier
	physical_resistance = p_data.physical_resistance
	magic_resistance = p_data.magic_resistance
	prof = p_data.prof
	spd = p_data.spd
	move_range = p_data.move
	jump = p_data.jump
	if p_data.skill_slots >= 0:
		skill_slots = p_data.skill_slots
	mods = [p_data.str_mod, p_data.dex_mod, p_data.con_mod, p_data.int_mod, p_data.wis_mod]
	_innate_abilities.assign(p_data.abilities)
	# Starting skills begin memorized, in order, for as long as their memory cost still fits.
	for a in _innate_abilities:
		if a.memory_cost <= skill_slots_free():
			_memorized.append(a)
	discipline_ranks = p_data.discipline_ranks.duplicate()
	equipment.mods = mods
	for item in p_data.starting_equipment:
		equipment.try_equip(item)
	equipment.slot_changed.connect(_on_equipment_changed)
	_sync_gear_defense(true)
	_rebuild_abilities()

## Adds a spell or skill that stays no matter what is equipped. Returns false (and learns nothing)
## when its requirements aren't met. Already known = true. Learning is not capped by memory slots:
## the new skill is memorized right away if enough slots are free, otherwise it is only learned (and can't be used).
func learn(a: Ability) -> bool:
	if _innate_abilities.has(a):
		return true
	if learn_block_reason(a) != "":
		return false
	_innate_abilities.append(a)
	if a.memory_cost <= skill_slots_free():
		_memorized.append(a)
	_rebuild_abilities()
	return true

# --- Disciplines ---------------------------------------------------------------

func discipline_rank(id: StringName) -> int:
	return int(discipline_ranks.get(id, 0))

## Sets the rank outright (training, level-up, tests). Negative clamps to 0.
func set_discipline_rank(id: StringName, rank: int) -> void:
	if rank <= 0:
		discipline_ranks.erase(id)
	else:
		discipline_ranks[id] = rank

## Why `a` can't be learned right now, or "" when it can. Plain abilities and spells have no requirement.
## A SkillDef needs its discipline rank. Slots don't matter here, only memorizing is slot-limited.
func learn_block_reason(a: Ability) -> String:
	if _innate_abilities.has(a):
		return ""
	if a.get("discipline") != null and a.get("req_rank") != null:
		var d: StringName = a.get("discipline")
		var need_rank: int = a.get("req_rank")
		if discipline_rank(d) < need_rank:
			return "%s needs %d %s (has %d)." % [a.display_name, need_rank, Discipline.display_name(d), discipline_rank(d)]
	return ""

func can_learn(a: Ability) -> bool:
	return learn_block_reason(a) == ""

func knows(a: Ability) -> bool:
	return _innate_abilities.has(a)

## Everything learned, memorized or not, in the order it was learned.
func learned_skills() -> Array[Ability]:
	return _innate_abilities.duplicate()

## The learned skills currently in memory slots (the ones the hotbar and AI can use).
func memorized_skills() -> Array[Ability]:
	return _memorized.duplicate()

func is_memorized(a: Ability) -> bool:
	return _memorized.has(a)

## Puts a learned skill into memory. False when it isn't learned or too few slots are free for its memory cost.
## Already memorized = true.
func memorize(a: Ability) -> bool:
	if _memorized.has(a):
		return true
	if not _innate_abilities.has(a) or a.memory_cost > skill_slots_free():
		return false
	_memorized.append(a)
	_rebuild_abilities()
	return true

## Takes a skill out of memory (it stays learned). False when it wasn't memorized.
func unmemorize(a: Ability) -> bool:
	if not _memorized.has(a):
		return false
	_memorized.erase(a)
	_rebuild_abilities()
	return true

## Memory slots taken: the sum of the memorized skills' memory costs.
func skill_slots_used() -> int:
	var total := 0
	for a in _memorized:
		total += a.memory_cost
	return total

func skill_slots_free() -> int:
	return maxi(skill_slots - skill_slots_used(), 0)

func cooldown_left(a: Ability) -> int:
	return int(cooldowns.get(a, 0))

func on_cooldown(a: Ability) -> bool:
	return cooldown_left(a) > 0

## Worn weapon attacks first (so the AI and the command menu lead with them), then innate extras.
func _rebuild_abilities() -> void:
	abilities.clear()
	for a in equipment.granted_abilities():
		if not abilities.has(a):
			abilities.append(a)
	for a in _memorized:
		if not abilities.has(a):
			abilities.append(a)

func _on_equipment_changed(_slot: int) -> void:
	_rebuild_abilities()
	_sync_gear_defense()

## Gear moves the Physical Armor/Magic Barrier CEILING; the current value is only clamped to it, never raised
## (except `refill`, used once at spawn), so unequip/re-equip can't be used to heal the pools.
func _sync_gear_defense(refill: bool = false) -> void:
	var new_physical_armor := roundi(equipment.total_defense(&"physical_armor"))
	var new_magic_barrier := roundi(equipment.total_defense(&"magic_barrier"))
	max_physical_armor = maxi(max_physical_armor + new_physical_armor - _gear_physical_armor, 0)
	max_magic_barrier = maxi(max_magic_barrier + new_magic_barrier - _gear_magic_barrier, 0)
	physical_armor = max_physical_armor if refill else mini(physical_armor, max_physical_armor)
	magic_barrier = max_magic_barrier if refill else mini(magic_barrier, max_magic_barrier)
	_gear_physical_armor = new_physical_armor
	_gear_magic_barrier = new_magic_barrier

## Turns toward `target` along the longer axis.
func face_toward(target: Vector2i) -> void:
	var d := target - cell
	if d == Vector2i.ZERO:
		return
	facing = Vector2i(signi(d.x), 0) if absi(d.x) >= absi(d.y) else Vector2i(0, signi(d.y))

func has_status(id: StringName) -> bool:
	return int(statuses.get(id, 0)) > 0

func is_alive() -> bool:
	return hp > 0

func mod(stat: int) -> int:
	return mods[stat]

## Phase 1. Order: (1) ablative mitigation, (2) threshold accumulation, (3) stack generation. Returns a report for the log/HUD.
## `attacker` (optional) brings its STR Shred bonus, DEX Pierce and INT Magic Pen into it.
func take_damage(amount: int, type: int = Ability.DamageType.PHYSICAL, attacker = null) -> Dictionary:  # attacker is a Unit (untyped: a script can't name itself as a type)
	var report := {"incoming": amount, "after_resistance": 0, "to_defense": 0, "to_core": 0, "stacks_gained": 0, "pierced": 0}
	if amount <= 0 or not is_alive():
		return report
	var physical := type == Ability.DamageType.PHYSICAL

	# Optional pre-step, OFF by default so the order is exactly: ablative, accumulate, stacks.
	var dealt := amount
	if Tuning.APPLY_RESISTANCE_IN_TAKE_DAMAGE:
		var resistance := physical_resistance if physical else magic_resistance
		dealt = maxi(roundi(amount * (1.0 - resistance)), 0)
	report["after_resistance"] = dealt

	# 1. Ablative mitigation: defense absorbs first, the remainder hits Core Health.
	var defense := physical_armor if physical else magic_barrier
	var pierced := pierced_amount(attacker, dealt, type)
	var to_defense := mini(dealt - pierced, defense)
	var to_core := dealt - to_defense
	if physical:
		physical_armor -= to_defense
	else:
		magic_barrier -= to_defense
	hp = maxi(hp - to_core, 0)
	report["to_defense"] = to_defense
	report["to_core"] = to_core
	report["pierced"] = pierced

	# 2. Accumulate. A unit that still had its armor / barrier up when the hit landed resists 30%.
	var impact := float(dealt)
	if defense > 0:
		impact *= 1.0 - Tuning.IMPACT_RESIST_WHILE_DEFENDED
	if attacker != null and physical:
		impact *= 1.0 + attacker.shred_bonus()
	impact *= 1.0 - resolve()
	if physical:
		physical_impact_pool += impact
	else:
		magic_impact_pool += impact

	# 3. Stacks: 1 per full threshold (12% of max HP) in the pool; the remainder stays until the
	# unit's next turn starts. Thresholds are consumed even when the cap swallows the stack.
	var threshold := max_hp * Tuning.THRESHOLD_FRACTION
	if not physical:
		threshold *= 1.0 + fracture_threshold_bonus()
	if threshold > 0.0:
		var pool := physical_impact_pool if physical else magic_impact_pool
		var full := floori(pool / threshold + Tuning.THRESHOLD_EPSILON)
		if full > 0:
			pool = maxf(pool - full * threshold, 0.0)
			var before := armor_shred_stacks if physical else fracture_stacks
			var after := mini(before + full, Tuning.MAX_STACKS)
			if physical:
				armor_shred_stacks = after
				physical_impact_pool = pool
			else:
				fracture_stacks = after
				magic_impact_pool = pool
			report["stacks_gained"] = after - before
	return report

# --- Stat effects (values in combat_tuning.gd) -----------------------------
## STR: extra physical impact fed to Armor Shred by this unit's hits (0.2 = +20%).
func shred_bonus() -> float:
	return maxi(mod(Ability.Stat.STR), 0) * Tuning.SHRED_PER_STR

## DEX / INT: fraction of this unit's physical / magical damage that skips the defense pool.
func pierce_fraction(type: int) -> float:
	var physical := type == Ability.DamageType.PHYSICAL
	var raw := maxi(mod(Ability.Stat.DEX), 0) * Tuning.PIERCE_PER_DEX if physical else maxi(mod(Ability.Stat.INT), 0) * Tuning.MAGIC_PEN_PER_INT
	return minf(raw, Tuning.PEN_MAX)

## Part of `amount` that `attacker` sends straight to Core Health. 0 for a null attacker.
func pierced_amount(attacker, amount: int, type: int) -> int:  # attacker: Unit or null
	if attacker == null:
		return 0
	return mini(floori(amount * attacker.pierce_fraction(type)), amount)

## WIS: fraction of incoming impact this unit shrugs off.
func resolve() -> float:
	return minf(maxi(mod(Ability.Stat.WIS), 0) * Tuning.RESOLVE_PER_WIS, Tuning.RESOLVE_MAX)

## CON: extra magical impact needed per Fracture stack (0.16 = +16%).
func fracture_threshold_bonus() -> float:
	return minf(maxi(mod(Ability.Stat.CON), 0) * Tuning.FRACTURE_THRESHOLD_PER_CON, Tuning.FRACTURE_THRESHOLD_BONUS_MAX)

## Phase 2. Called on the TARGET. Evaluates Overload -> Breach -> Disrupt and stops at the first
## tier that applies. Returns {tier, effect, stacks_consumed, resistance_delta}.
func apply_cascading_status(category: int) -> Dictionary:
	var physical := category == StatusCategory.PHYSICAL
	var stacks := armor_shred_stacks if physical else fracture_stacks
	var defense := physical_armor if physical else magic_barrier
	var result := {"tier": StatusTier.NONE, "effect": &"", "stacks_consumed": 0, "resistance_delta": 0.0}

	# Tier 3 Overload: the stack check. Ignores the defense pool entirely.
	if stacks >= Tuning.OVERLOAD_STACK_COST:
		if physical:
			armor_shred_stacks -= Tuning.OVERLOAD_STACK_COST
		else:
			fracture_stacks -= Tuning.OVERLOAD_STACK_COST
		var effect: StringName = Tuning.EFFECT_OVERLOAD[category]
		statuses[effect] = Tuning.OVERLOAD_TURNS
		result["tier"] = StatusTier.OVERLOAD
		result["effect"] = effect
		result["stacks_consumed"] = Tuning.OVERLOAD_STACK_COST
		return result

	# Tier 2 Breach: enough stacks (but not enough for Overload).
	if stacks >= Tuning.BREACH_STACK_REQUIREMENT:
		var effect: StringName = Tuning.EFFECT_BREACH[category]
		statuses[effect] = Tuning.BREACH_TURNS
		result["tier"] = StatusTier.BREACH
		result["effect"] = effect
		return result

	# Tier 1 Disrupt: guaranteed fallback. Strips the OPPOSITE resistance to reward hybrid parties.
	var old_value := magic_resistance if physical else physical_resistance
	var new_value := maxf(old_value - Tuning.DISRUPT_RESISTANCE_REDUCTION, Tuning.RESISTANCE_MIN)
	if physical:
		magic_resistance = new_value
	else:
		physical_resistance = new_value
	result["tier"] = StatusTier.DISRUPT
	result["effect"] = &"disrupt"
	result["resistance_delta"] = new_value - old_value
	return result

## Turn start: action = bonus = reaction = 1, movement = MOVE.
func start_turn() -> void:
	# Unfinished Armor Shred / Fracture progress (less than one full threshold) does not survive
	# into the unit's own turn. Earned stacks are kept.
	physical_impact_pool = 0.0
	magic_impact_pool = 0.0
	ap = minf(ap + Tuning.AP_REGEN, max_ap)
	movement = move_range
	_tick_cooldowns()
	_tick_statuses()

## Statuses last N of this unit's own turns, then drop.
func _tick_statuses() -> void:
	for id: StringName in statuses.keys():
		var left: int = int(statuses[id]) - 1
		if left <= 0:
			statuses.erase(id)
		else:
			statuses[id] = left

func _tick_cooldowns() -> void:
	for a: Ability in cooldowns.keys():
		var left: int = cooldowns[a] - 1
		if left <= 0:
			cooldowns.erase(a)
		else:
			cooldowns[a] = left

## True when this unit has `cost` AP to spend.
func can_afford(cost: float) -> bool:
	return ap >= cost

## Base-tier check: enough AP to start using `a` at all.
func can_use(a: Ability) -> bool:
	return is_available(a) and not on_cooldown(a) and can_afford(a.ap_cost_for_tier(1))

## A learned skill / spell that is not in a memory slot can't be used (Divinity: Original Sin 2 style).
## Weapon attacks come from gear, not from learning, so they are always available.
func is_available(a: Ability) -> bool:
	return not _innate_abilities.has(a) or _memorized.has(a)

## Highest tier (1..max_tier) of `a` this unit can pay for right now, or 0 if it can't use it at all.
func max_affordable_tier(a: Ability, max_tier: int = 3) -> int:
	var best := 0
	if not is_available(a) or on_cooldown(a):
		return best
	for tier in range(1, max_tier + 1):
		if can_afford(a.ap_cost_for_tier(tier)):
			best = tier
	return best

## Pays for one use of `a` at `tier`. Callers check can_afford() first.
func spend(a: Ability, tier: int = 1) -> void:
	ap = maxf(ap - a.ap_cost_for_tier(tier), 0.0)
	# +1: the tick at the start of this unit's next turn eats one, so cooldown 1 skips one turn.
	var cd := a.cooldown_turns
	if cd > 0:
		cooldowns[a] = cd + 1
